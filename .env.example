# ===================================================================
# CONFIGURACIÓN DEL SERVIDOR
# ===================================================================
PUERTO=3000
ENTORNO=desarrollo # desarrollo | produccion
URL_FRONTEND=http://localhost:8081

# Permitir operaciones anónimas sin token JWT de Supabase (SÓLO PARA DESARROLLO/TESTING LOCAL)
# En producción DEBE ser false
PERMITIR_ACCESO_ANONIMO=false

# ===================================================================
# SUPABASE (Base de datos, Autenticación y Storage)
# ===================================================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_CLAVE_ANONIMA=tu_clave_anonima_publica
SUPABASE_CLAVE_SERVICIO=tu_clave_de_servicio_secreta_service_role
SUPABASE_BUCKET_DOCUMENTOS=pdf_vault

# ===================================================================
# GROQ AI (Modelos de lenguaje para resumen y traducción)
# ===================================================================
GROQ_CLAVE_API=gsk_tu_clave_api_de_groq
GROQ_MODELO=llama-3.3-70b-versatile

# ===================================================================
# GESTIÓN DE ARCHIVOS TEMPORALES
# ===================================================================
RUTA_ARCHIVOS_TEMPORALES=./temp_uploads
# Límite máximo en bytes (2147483648 = 2 GB)
LIMITE_TAMANIO_ARCHIVO_BYTES=2147483648
# Tiempo de vida de archivos temporales en minutos antes de ser eliminados por el recolector
TTL_ARCHIVOS_TEMPORALES_MINUTOS=30
